# Port for the local web server
PORT=3030
# Bind address. Use 0.0.0.0 when a tunnel/reverse proxy must reach this server.
HOST=0.0.0.0

# Optional. Copy the Signing Secret from SeaTalk Open Platform > Event Callback.
# When set, incoming requests must include the matching `Signature` header.
SEATALK_SIGNING_SECRET=
# Credentials from SeaTalk Open Platform > Basic Info & Credentials.
# The bot uses these to send confirmation cards and thread replies.
SEATALK_APP_ID=
SEATALK_APP_SECRET=
# Optional: use a pre-issued token instead of app ID/secret.
SEATALK_ACCESS_TOKEN=
SEATALK_API_BASE_URL=https://openapi.seatalk.io

# Chatflow endpoint and token. Keep the token server-side; never put it in public/app.js.
CHATFLOW_API_URL=https://ai.insea.io/api/chatflows/26607/run?stream=true
CHATFLOW_API_TOKEN=

# Task extraction provider: auto | chatflow | compass | rules.
# auto ưu tiên Chatflow, sau đó Compass, cuối cùng dùng parser theo nhãn.
TASK_EXTRACTOR=auto

# Optional comma-separated Vietnamese public holidays/non-working dates.
# Format: DD/MM/YYYY or YYYY-MM-DD. Weekends are always excluded for week-based deadlines.
HOLIDAY_DATES=

# Optional Compass LLM fallback/provider (same setup as the Claude project).
COMPASS_BASE_URL=https://compass.llm.shopee.io/compass-api/v1
COMPASS_API_KEY=
COMPASS_MODEL=compass-max

# Google Sheets API through OAuth. The Google account that signs in must have Editor access to the spreadsheet.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Sheet1
# Eight columns in this order: ID, Task, PIC, Deadline, Priority, Status, CreatedAt, UpdatedAt.
GOOGLE_SHEETS_RANGE=A:H
# Create a Web application OAuth client in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3030/auth/google/callback
GOOGLE_OAUTH_TOKEN_PATH=.oauth/google-token.json
# false chỉ visualize kết quả extract; true cho phép ghi vào Google Sheet sau khi OAuth.
GOOGLE_SHEETS_WRITE_ENABLED=false
